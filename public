<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Cannon Demo</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 40px auto; padding: 0 16px; }
    .card { border: 1px solid #ddd; border-radius: 12px; padding: 20px; }
    button { padding: 10px 16px; cursor: pointer; }
    pre { background: #f6f6f6; padding: 16px; border-radius: 8px; overflow: auto; }
    img { max-width: 100%; margin-top: 16px; border-radius: 8px; }
  </style>
</head>
<body>
  <h1>Cannon Demo</h1>
  <div class="card">
    <input type="file" id="file" accept="image/*"><br><br>
    <button onclick="send()">예측</button>
    <div id="preview"></div>
    <pre id="res">아직 결과 없음</pre>
  </div>

  <script>
    const fileInput = document.getElementById('file');
    const preview = document.getElementById('preview');

    fileInput.addEventListener('change', () => {
      preview.innerHTML = '';
      const f = fileInput.files[0];
      if (!f) return;
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      preview.appendChild(img);
    });

    async function send(){
      const f = document.getElementById('file').files[0];
      if (!f) {
        document.getElementById('res').textContent = '이미지를 먼저 선택하세요.';
        return;
      }

      const fd = new FormData();
      fd.append('file', f);

      document.getElementById('res').textContent = '처리 중...';

      try {
        const r = await fetch('/api/predict', { method:'POST', body:fd });
        const d = await r.json();
        document.getElementById('res').textContent = JSON.stringify(d, null, 2);
      } catch (e) {
        document.getElementById('res').textContent = '오류: ' + e.message;
      }
    }
  </script>
</body>
</html>
